# Copy this file to server/.env and fill in real values.
# server/.env is git-ignored. Never commit it and never paste its values into chats.

NODE_ENV=development
PORT=4000

# MongoDB Atlas connection string for the DEV database (docs/SETUP.md step 2).
# Replace <user>, <password> and <cluster-host>; keep /chat_dev as the database name.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/chat_dev?retryWrites=true&w=majority

# Origin the browser uses to open the app. In development this is the Vite dev server.
APP_ORIGIN=http://localhost:5173

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Reverse proxies in front of the server: 0 locally, usually 1 on hosting platforms.
TRUST_PROXY_HOPS=0

# ── Email (docs/SETUP.md step 4) ─────────────────────────────────────────────
# Leave MAIL_TRANSPORT unset in development: emails (verification / reset links) are then
# printed in the server terminal instead of being sent. Production requires "smtp".
# On hosts that block SMTP (Render's free plan), use an HTTPS email API instead.
# Mailjet (no phone verification):
# MAIL_TRANSPORT=mailjet
# MAILJET_API_KEY=<API key>
# MAILJET_SECRET_KEY=<Secret key>
# MAIL_FROM=Adda <the-sender-you-verified-in-mailjet@example.com>
#
# Or Brevo:
# MAIL_TRANSPORT=brevo
# BREVO_API_KEY=<API key from Brevo: SMTP & API → API Keys>
# MAIL_FROM=Adda <the-sender-you-verified-in-brevo@example.com>
#
# MAIL_TRANSPORT=smtp
# MAIL_FROM=Private Chat <your-verified-sender@example.com>
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=<your SMTP login>
# SMTP_PASS=<your SMTP key>

# ── Photos and videos (docs/SETUP.md step 5) ───────────────────────────────────
# Without this, development stores files in server/.media on this computer.
# Production needs Cloudinary (free plan, no card). Copy the "API environment variable"
# from the Cloudinary dashboard (it contains your API secret — keep it only in server/.env):
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# ── GIFs (docs/SETUP.md step 7, optional) ───────────────────────────────────────
# KLIPY app key (free, no card). Without it the GIF button says GIFs aren't available.
# KLIPY_APP_KEY=<your KLIPY app key>

# ── Push notifications (docs/SETUP.md step 6) ──────────────────────────────────
# Generate once with:  node -e "console.log(require('web-push').generateVAPIDKeys())"  (in server/)
# Keep the same pair forever; production needs the same values (changing them breaks
# every existing subscription). The private key is a secret.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
